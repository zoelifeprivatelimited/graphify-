# Copy to .env (git-ignored) and fill in every REQUIRED value.
# Generate each secret with: openssl rand -hex 32

# REQUIRED — signs dashboard session tokens. Never leave empty or use a placeholder.
JWT_SECRET=
# REQUIRED — signs/derives OmniRoute API keys.
API_KEY_SECRET=
# REQUIRED — encrypts the SQLite database at rest (keep a backup; losing it loses your data).
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Dashboard admin password used on first boot only (ignored once one is saved).
# Use a strong value, or leave empty to set it in the onboarding wizard.
INITIAL_PASSWORD=

# V8 heap in MB. 1024 is fine for the dashboard and light chat; use 8192 (and
# OMNIROUTE_CONTAINER_MEMORY=10g) when coding agents like Claude Code route through it.
OMNIROUTE_MEMORY_MB=1024
OMNIROUTE_CONTAINER_MEMORY=2g

# Host port the dashboard/API is published on (127.0.0.1 only).
OMNIROUTE_HOST_PORT=20128
